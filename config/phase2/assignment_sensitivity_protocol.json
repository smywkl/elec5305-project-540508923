  "rq6a_assignment_level_decomposition": {
    "analysis_roles": {
      "cancellation_state": {
        "metrics": ["R", "K"],
        "question": "How does source-position assignment change cross-stem cancellation or reinforcement?",
        "exact_relation": "R = 1 + K",
        "interpretation": "R and K are the same cancellation-state information under an additive constant of 1. Assignment variation in R is mathematically identical to assignment variation in K.",
        "A_and_I_as_competing_explanations_of_R": false
      },
      "normalized_downstream_error_magnitude": {
        "metrics": ["V", "U", "W"],
        "question": "How are assignment-induced changes in actual normalized downstream error V associated with individual rendered-error load U and cross-stem interaction contribution W?",
        "exact_relation": "V = U + W"
      }
    },
    "prohibited_interpretation": "Do not ask whether A or I independently explains R more; R variation and K variation are mathematically identical because R = 1 + I/A.",
    "definitions": {
      "A_p": "sum_j ||d_j||^2",
      "I_p": "2 * sum_{i<j} <d_i,d_j>",
      "T_p": "A_p + I_p = ||sum_j d_j||^2",
      "R_p": "T_p / A_p",
      "K_p": "I_p / A_p",
      "exact_identity": "R_p = 1 + K_p"
    },
    "K_interpretation": {
      "negative": "net cancellation",
      "zero": "neutral",
      "positive": "net reinforcement"
    },
    "oracle_normalized": {
      "E_oracle_p": "||y_oracle,p||^2",
      "U_p": "A_p / E_oracle,p",
      "W_p": "I_p / E_oracle,p",
      "V_p": "T_p / E_oracle,p",
      "exact_identity": "V_p = U_p + W_p",
      "U_interpretation": "individual rendered-error load relative to Oracle",
      "W_interpretation": "cross-stem interaction contribution relative to Oracle",
      "V_interpretation": "actual total normalized downstream error"
    },
    "edge_cases": {
      "A_p_exact_zero": "STOP: R_p and K_p are undefined; do not add epsilon",
      "E_oracle_p_exact_zero": "STOP: U_p, W_p, and V_p are undefined; do not add epsilon"
    }
  },
  "rq6b_stem_angle_marginals": {
    "component_energy": "E_j(a) = ||d_{j,a}||^2",
    "marginal_R": "M_R(song, condition, stem, angle) = median R across the 6 assignments where that stem occupies that angle",
